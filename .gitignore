.DS_Store

# Per-checkout list of consuming project names, for the leak guard.
# Never committed: naming them here would be the leak the guard prevents.
.github/consumers.txt

# Eval run output — regenerated by every `claude plugin eval` run, and each run
# writes a fresh timestamped directory. The suite is the artifact; its scores are
# a measurement of one moment, against one model, at one cost.
evals/results/

# Bytecode from running the ticket linter, or from importing it to test one of its
# checks in isolation. The script is stdlib-only and run directly, so nothing here
# is ever an input.
__pycache__/

# Working notes and plans for changes to this kit. Same treatment the stage
# skills give a consuming project's docs/plans/: scratch for work in flight,
# not a record of it. The commits and the files themselves are the record.
docs/
